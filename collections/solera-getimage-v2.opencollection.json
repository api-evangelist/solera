{
  "opencollection": "1.0.0",
  "info": {
    "name": "Audatex Assignment Get Document API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Version",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /api/v{version}",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v:version",
            "headers": [
              {
                "name": "api-version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          }
        }
      ]
    }
  ],
  "bundled": true
}